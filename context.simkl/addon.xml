<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
SIMKL Context Menu
Version: 1.0.3
Last Modified: 2026-05-25

CHANGELOG:
1.0.3 - Renamed from context.simkl.rate to context.simkl
        Standalone episode and season resolution (no scrobbler changes required)
        Fix: episodes now resolve to parent show before calling scrobbler.
             GetEpisodeDetails → tvshowid; scrobbler receives media_type=show
             with the correct tvshowid. Previously the scrobbler received
             media_type=episode and silently submitted S01E01 to SIMKL.
        Fix: seasons now resolve to parent show before calling scrobbler.
             GetSeasonDetails → tvshowid; previously produced "Could not find
             item details" error because the scrobbler had no season handler.
        Fix: error notification shown to user when resolution fails (was
             silent log-only failure).
        Architecture: all type resolution now happens in this addon before
             RunScript fires. Scrobbler always receives movie or show.
1.0.1 - CRITICAL FIX: Media type detection + professional logging
        - FIXED: Uses ListItem.DBTYPE instead of Container.Content()
        - NOW WORKS: In all views (library, in progress, recently added, etc.)
        - ADDED: VERSION constant for version tracking
        - ADDED: Comprehensive logging with version prefix
        - ADDED: Error handling with try/except and traceback
        - ADDED: Null checks for DBID and media_type
        - IMPROVED: Professional code structure matching main addon
1.0.0 - Initial release with context menu registration
-->
<addon id="context.simkl"
       name="SIMKL - Context Menu"
       version="1.0.3"
       provider-name="Claude.ai with assistance from Michael Beck">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.simkl.scrobbler" version="7.8.4"/>
    </requires>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="addon.py">
                <label>32000</label>
                <visible>String.IsEqual(ListItem.dbtype,movie) | String.IsEqual(ListItem.dbtype,tvshow) | String.IsEqual(ListItem.dbtype,season) | String.IsEqual(ListItem.dbtype,episode)</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">SIMKL context menu actions for your Kodi library</summary>
        <description lang="en_GB">Adds SIMKL actions to the right-click context menu in your library. Currently: Rate on SIMKL. Planned: Toggle Watched, Sync to SIMKL.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
